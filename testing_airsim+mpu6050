import socket
import os
import time
from datetime import datetime
import airsim
import math

# 🔧 Настройки
ESP32_IP = "172.20.10.3"
PORT = 3333

# 📁 Папка для логов
log_dir = "logs"
os.makedirs(log_dir, exist_ok=True)

timestamp = datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
log_file = os.path.join(log_dir, f"orientation_airsim_{timestamp}.txt")
headers = ["Time(s)", "Yaw(°)", "Pitch(°)", "Roll(°)", "Control_Method"]

with open(log_file, "w", encoding="utf-8") as f:
    f.write("=== AirSim Control Test ===\n")
    f.write("\t".join(headers) + "\n")

# 🔗 Настройка сокета
sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
sock.bind(("", PORT))
sock.settimeout(0.1)

# 🔗 Подключение к AirSim
print("🚁 Connecting to AirSim...")
client = airsim.MultirotorClient()
client.confirmConnection()
client.enableApiControl(True)
client.armDisarm(True)

print("🛫 Taking off...")
client.takeoffAsync().join()
print("✅ Takeoff complete")

print("⬆️ Moving to altitude 10m...")
client.moveToZAsync(-10, 3).join()
print("✅ Altitude set")

# Даем время на стабилизацию
time.sleep(2)

print(f"📡 Ожидание данных от ESP32 ({ESP32_IP}:{PORT})...")
sock.sendto(b"START", (ESP32_IP, PORT))
print("🚀 Отправлена команда START\n")

start_time = time.time()
last_command_time = time.time()

# Калибровочные значения
MANUAL_ZERO_PITCH = -1.0
MANUAL_ZERO_ROLL = 14.0

print(f"🔧 Калибровочные значения: Pitch={MANUAL_ZERO_PITCH}°, Roll={MANUAL_ZERO_ROLL}°")

# Переменные для управления
prev_yaw = 0
prev_pitch = 0
prev_roll = 0

# Переменная для отслеживания режима управления
control_method = "position"

def degrees_to_radians(deg):
    return deg * math.pi / 180.0

def apply_dead_zone(value, dead_zone=5.0):
    if abs(value) < dead_zone:
        return 0
    return value

try:
    while True:
        current_time = time.time()
        
        try:
            data, addr = sock.recvfrom(1024)
            msg = data.decode().strip()

            if ',' in msg:
                parts = msg.split(',')
                if len(parts) == 3:
                    try:
                        yaw = float(parts[0])
                        pitch = float(parts[1])
                        roll = float(parts[2])
                        
                        # Сглаживание
                        yaw = 0.8 * yaw + 0.2 * prev_yaw
                        pitch = 0.8 * pitch + 0.2 * prev_pitch
                        roll = 0.8 * roll + 0.2 * prev_roll
                        
                        prev_yaw, prev_pitch, prev_roll = yaw, pitch, roll
                        
                        # Вычисляем относительные углы
                        rel_pitch = pitch - MANUAL_ZERO_PITCH
                        rel_roll = roll - MANUAL_ZERO_ROLL
                        
                        # Применяем мертвую зону
                        rel_pitch = apply_dead_zone(rel_pitch, 10.0)
                        rel_roll = apply_dead_zone(rel_roll, 10.0)
                        
                        print(f"📊 Tilt: P={rel_pitch:5.1f}°, R={rel_roll:5.1f}° | Yaw: {yaw:5.1f}°")
                        
                        # 🔄 АЛЬТЕРНАТИВНЫЕ МЕТОДЫ УПРАВЛЕНИЯ
                        
                        # Получаем текущую позицию дрона
                        current_pose = client.simGetVehiclePose()
                        current_x = current_pose.position.x_val
                        current_y = current_pose.position.y_val
                        
                        # Метод 1: Управление позицией (более надежно)
                        move_distance = 0.5  # метров на каждые 10 градусов наклона
                        
                        target_x = current_x + (rel_pitch * move_distance / 10.0)
                        target_y = current_y + (-rel_roll * move_distance / 10.0)
                        
                        # Ограничиваем перемещение
                        max_move = 2.0
                        target_x = max(min(target_x, current_x + max_move), current_x - max_move)
                        target_y = max(min(target_y, current_y + max_move), current_y - max_move)
                        
                        # Управление через позицию
                        client.moveToPositionAsync(
                            target_x, target_y, -10,  # x, y, z
                            1.0,  # скорость
                            0.1,  # timeout
                            airsim.DrivetrainType.MaxDegreeOfFreedom,
                            airsim.YawMode(False, yaw)  # фиксированный yaw
                        )
                        
                        control_method = "position"
                        
                        print(f"🎮 Position Control: X={target_x:.1f}, Y={target_y:.1f}")
                        
                        # Метод 2: Управление ориентацией (альтернатива)
                        # roll_rad = degrees_to_radians(rel_roll * 0.5)
                        # pitch_rad = degrees_to_radians(rel_pitch * 0.5)
                        # yaw_rad = degrees_to_radians(yaw)
                        # 
                        # client.moveByRollPitchYawZAsync(
                        #     roll_rad, pitch_rad, yaw_rad, -10, 0.1
                        # )
                        # control_method = "orientation"
                        # print(f"🎮 Orientation Control: R={roll_rad:.2f}, P={pitch_rad:.2f}")
                        
                        last_command_time = current_time
                        
                        # Логирование
                        log_time = round(current_time - start_time, 2)
                        row = [
                            str(log_time), 
                            str(round(yaw, 2)), 
                            str(round(pitch, 2)), 
                            str(round(roll, 2)),
                            control_method
                        ]
                        with open(log_file, "a", encoding="utf-8") as f:
                            f.write("\t".join(row) + "\n")
                            
                    except ValueError:
                        pass
                        
        except socket.timeout:
            pass
        
        # Keep-alive для AirSim
        if current_time - last_command_time > 0.2:
            # Периодически отправляем команду зависания
            current_pose = client.simGetVehiclePose()
            client.moveToPositionAsync(
                current_pose.position.x_val,
                current_pose.position.y_val, 
                -10,
                1.0, 0.1,
                airsim.DrivetrainType.MaxDegreeOfFreedom,
                airsim.YawMode(False, 0)
            )
            last_command_time = current_time

except KeyboardInterrupt:
    print("\n🛑 Остановка...")

finally:
    sock.sendto(b"STOP", (ESP32_IP, PORT))
    sock.close()
    print("🛬 Landing...")
    client.landAsync().join()
    client.armDisarm(False)
    client.enableApiControl(False)
    print(f"💾 Данные сохранены в {log_file}")